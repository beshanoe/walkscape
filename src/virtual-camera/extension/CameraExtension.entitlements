<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The camera extension's entitlements; build.sh fills in @TEAM_ID@. Its Mach service name
     (CMIOExtensionMachServiceName in CameraExtension-Info.plist) must start with this app group. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>@TEAM_ID@.dev.walkscape.app.camera</string>
	</array>
</dict>
</plist>
